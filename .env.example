# Obbligatoria
NUXT_PUBLIC_BACKEND_URL="https://admin.xxx.it"

# Opzionali 
NUXT_IMAGE_PROVIDER="cloudflare"
NUXT_IMAGE_CLOUDFLARE_BASE_URL="https://cdn.xxx.it"

# cache dati di nuxt-multi-cache: con NUXT_REDIS_URL usa Redis, altrimenti fs se NUXT_CACHE_ENABLED è "true"
# NUXT_REDIS_URL="redis://:password@host:6379/0"
# NUXT_CACHE_ENABLED="true"

# header CDN per Cloudflare (Cache Rules sul dashboard, purge da craft-toolkit)
# NUXT_CDN_CACHE_ENABLED="true"
